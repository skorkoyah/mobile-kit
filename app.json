{
  "expo": {
    "name": "Kit",
    "slug": "mobile-kit",
    "version": "0.1.0",
    "scheme": "kit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.kit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourname.kit",
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F4",
          "dark": {
            "backgroundColor": "#151821"
          }
        }
      ],
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kit uses Face ID to lock your private entries so only you can open them."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1B8A64"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Kit saves the images you export to your photo library.",
          "savePhotosPermission": "Kit saves the images you export to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9107d5a3-e236-4d0c-9f60-274b3fe7f46e"
      }
    },
    "owner": "skorkoyah",
    "backgroundColor": "#F6F7F4"
  }
}
